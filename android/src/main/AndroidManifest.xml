<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Bluetooth permissions.
         BLUETOOTH and BLUETOOTH_ADMIN are legacy normal permissions required by AltBeacon's
         PermissionsInspector on all API levels. On Android 12+ they are automatically granted
         and act as no-ops, but removing them (via maxSdkVersion="30") causes AltBeacon to log
         errors and believe BLE scanning is unavailable.
         BLUETOOTH_SCAN and BLUETOOTH_CONNECT cover the runtime permission requirements on API 31+. -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Location permissions required for BLE scanning -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Foreground service for background BLE scanning -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <!-- Notifications permission (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Receive boot broadcast to restart monitoring after device reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Battery optimization exemption for reliable background BLE scanning -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />

    <!--
         Package-visibility declaration required by Android 11+ so that
         androidx.car.app's CarConnection can resolve the Android Auto /
         Automotive OS content provider. Without this, CarConnection.type
         silently reports CONNECTION_TYPE_NOT_CONNECTED on freshly-started
         processes (e.g. after the foreground service is revived via
         START_STICKY following a swipe-away), causing spurious disconnect
         events.
    -->
    <queries>
        <intent>
            <action android:name="androidx.car.app.connection.action.CAR_PROVIDER" />
        </intent>
    </queries>

    <application>
        <!-- AltBeacon background scanning service -->
        <service
            android:name="org.altbeacon.beacon.service.BeaconService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="connectedDevice"
            android:isolatedProcess="false"
            android:label="iBeacon Service"
            tools:replace="android:label,android:foregroundServiceType" />

        <service
            android:name="org.altbeacon.beacon.BeaconIntentProcessor"
            android:exported="false" />

        <!-- Foreground service for sustained background scanning -->
        <service
            android:name="expo.modules.beacon.BeaconForegroundService"
            android:foregroundServiceType="connectedDevice"
            android:stopWithTask="false"
            android:exported="false" />

        <!-- Restart monitoring after boot.
             android:exported="true" is required for the system to deliver BOOT_COMPLETED.
             No android:permission — the incorrect RECEIVE_BOOT_COMPLETED attribute was
             restricting incoming broadcasts instead of restricting who can receive them. -->
        <receiver
            android:name="expo.modules.beacon.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- Direct-boot phase boot (Android 7+). Harmless without
                     directBootAware="true"; declaring early so the only
                     follow-up needed for true direct-boot support is that
                     single attribute. -->
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <!-- Restart observers after the host app is updated. -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <!-- Self-scheduled retry when BT isn't ready at boot -->
                <action android:name="expo.modules.beacon.ACTION_RETRY_MONITORING" />
                <!-- Self-scheduled CarPlay watchdog (11-min cadence; above
                     setExactAndAllowWhileIdle per-app quota). -->
                <action android:name="expo.modules.beacon.ACTION_CARPLAY_WATCHDOG" />
                <!-- Near-term keepalive armed when the app task is swiped away. -->
                <action android:name="expo.modules.beacon.ACTION_TASK_REMOVED_KEEPALIVE" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
