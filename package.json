{
  "name": "expo-beacon",
  "version": "1.0.2",
  "description": "Expo module for scanning, pairing, and monitoring iBeacons on Android and iOS",
  "main": "build/cjs/index.js",
  "module": "build/index.js",
  "react-native": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "react-native": "./build/index.js",
      "import": "./build/index.js",
      "require": "./build/cjs/index.js",
      "default": "./build/index.js"
    },
    "./plugin": {
      "types": "./plugin/build/index.d.ts",
      "require": "./plugin/build/index.js",
      "default": "./plugin/build/index.js"
    },
    "./app.plugin": {
      "types": "./plugin/build/index.d.ts",
      "require": "./app.plugin.js",
      "default": "./app.plugin.js"
    },
    "./app.plugin.js": {
      "types": "./plugin/build/index.d.ts",
      "require": "./app.plugin.js",
      "default": "./app.plugin.js"
    }
  },
  "files": [
    "build/",
    "plugin/build/",
    "app.plugin.js",
    "docs/",
    "llms.txt",
    "ios/",
    "android/src/",
    "android/build.gradle",
    "expo-module.config.json",
    "src/",
    "!src/__tests__/"
  ],
  "scripts": {
    "build": "expo-module build && npm run build:cjs && npm run build:package-metadata && npm run build:plugin",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:package-metadata": "node scripts/write-build-package-metadata.cjs",
    "build:plugin": "tsc -p plugin/tsconfig.json",
    "docs:api": "typedoc --options typedoc.json && typedoc --options plugin/typedoc.json",
    "docs:check": "npm run docs:api && git diff --exit-code -- docs/reference",
    "test:types": "npm run build && tsc -p tests/consumer/tsconfig.json",
    "clean": "expo-module clean",
    "lint": "expo-module lint",
    "test": "expo-module test",
    "prepare": "expo-module prepare && npm run build:cjs && npm run build:package-metadata && npm run build:plugin",
    "prepublishOnly": "expo-module prepublishOnly && npm run build:cjs && npm run build:package-metadata && npm run build:plugin",
    "expo-module": "expo-module",
    "open:ios": "xed example/ios",
    "open:android": "open -a \"Android Studio\" example/android"
  },
  "keywords": [
    "react-native",
    "expo",
    "ibeacon",
    "beacon",
    "ble",
    "bluetooth",
    "ranging",
    "monitoring",
    "expo-beacon",
    "ExpoBeacon"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/martinmikesCCS/expo-beacon.git"
  },
  "bugs": {
    "url": "https://github.com/martinmikesCCS/expo-beacon/issues"
  },
  "author": "mikes <martin.mikes@ccs.cz> (https://github.com/martinmikesCCS)",
  "license": "MIT",
  "homepage": "https://github.com/martinmikesCCS/expo-beacon#readme",
  "devDependencies": {
    "@babel/preset-env": "^7.29.2",
    "@babel/preset-typescript": "^7.28.5",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@types/node": "^25.0.0",
    "@types/react": "~19.1.1",
    "babel-jest": "^29.7.0",
    "eslint": "^9.39.4",
    "eslint-config-universe": "^15.0.3",
    "eslint-plugin-n": "^17.24.0",
    "expo": "~55.0.8",
    "expo-module-scripts": "^55.0.2",
    "react": "19.2.0",
    "react-native": "0.83.2",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@expo/config-plugins": "*",
    "expo": ">=51.0.0",
    "react": "*",
    "react-native": "*"
  }
}
